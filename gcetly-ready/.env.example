# Zero ongoing cost -- local Ollama only.
# Install: https://ollama.com  then: ollama serve
OLLAMA_HOST=http://localhost:11434

# Small free model (recommended if no money / weak PC):
#   ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# Efficiency profile: less RAM, shorter answers, fewer web searches
FREE_MODE=1

OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=90000
# OLLAMA_NUM_THREAD=4

# Optional free web fallback (DuckDuckGo used if empty)
BRAVE_API_KEY=

SEARCH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=20

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_ACCESS_TOKEN=

# --- LLM provider (permanent vs free cloud) ---
# ollama     = local/college PC (recommended permanent, ₹0)
# openrouter = Vercel / no PC (free models can become paid)
LLM_PROVIDER=ollama

# OpenRouter (only if LLM_PROVIDER=openrouter)
# Get a free key: https://openrouter.ai/keys
# Pick a free model slug from https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SITE_URL=https://gcetly.ac.in
# STRICT_PROVIDER=1

# Hugging Face (LLM_PROVIDER=huggingface)
HF_TOKEN=
HF_MODEL=openai/gpt-oss-20b
# HF_BASE_URL=https://router.huggingface.co/v1

# Performance caches (ms)
# RETRIEVAL_CACHE_TTL_MS=60000
# ANSWER_CACHE_TTL_MS=120000

# Only if Ollama is on another trusted private host
# ALLOW_REMOTE_OLLAMA=1

# --- Speed (laptop / weak CPU) ---
FREE_MODE=1
FAQ_FAST_PATH=1
FAQ_FAST_MIN_SCORE=4
# Compare local knowledge and live web evidence for every substantive question.
HYBRID_ALWAYS_BOTH=1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_PREDICT=180
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=45000
SEARCH_TIMEOUT_MS=4000

# Vector RAG (Ollama embeddings)
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_ON_INDEX=1
VECTOR_RETRIEVAL=1
